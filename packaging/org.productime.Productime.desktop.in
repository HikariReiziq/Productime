[Desktop Entry]
Type=Application
Version=1.0
Name=Productime
GenericName=Focus Timer and Alarm
Comment=Time-blocked Pomodoro targets, alarms with wake-up missions, stopwatch, timers, and a productivity report
Exec=@EXEC@
Icon=org.productime.Productime
Terminal=false
Categories=Utility;Clock;Education;
Keywords=pomodoro;timer;alarm;stopwatch;focus;productivity;
StartupNotify=true
StartupWMClass=org.productime.Productime
X-GNOME-UsesNotifications=true
Actions=new-target;new-alarm;new-timer;stopwatch;

[Desktop Action new-target]
Name=New Target
Exec=@EXEC@ --open=new-target

[Desktop Action new-alarm]
Name=New Alarm
Exec=@EXEC@ --open=new-alarm

[Desktop Action new-timer]
Name=New Timer
Exec=@EXEC@ --open=new-timer

[Desktop Action stopwatch]
Name=Start Stopwatch
Exec=@EXEC@ --open=stopwatch
